# OkGTM environment variables (names only — NEVER commit real values).
# Copy to .env.local and fill in. Secrets live here (local) and in the
# per-deployment env stores (Convex: `npx convex env set`, Vercel: dashboard
# or `vercel env add`). Never push .env.local to git (it is gitignored).

# ── Convex ─────────────────────────────────────────────────────────────
# Written by `npx convex dev`. For prod, point at the production deployment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# ── Convex action env (also set via `npx convex env set` per deployment) ─
MINDCASE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
RESEND_API_KEY=
LEAD_FROM_ADDRESS=OkGTM <ujval@okgtm.com>
